{
  "name": "@nikolasd/crew-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "generate": "cargo run -p crew-xtask -- generate",
    "build": "bun run --cwd packages/extension build",
    "format:check": "biome format .",
    "format:write": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test && cargo test --workspace",
    "check": "bun run generate --check && bun run format:check && bun run typecheck && bun run build && bun test && cargo test --workspace"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
